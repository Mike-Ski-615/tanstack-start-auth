# 测试环境变量模板。复制为 .env.test 并填入本机数据库。
#
# ⚠️ 不要指向生产库：测试会真实建表、建用户、删数据。
#
# 首次准备：
#   psql -h 127.0.0.1 -U postgres -c "CREATE DATABASE tanstack_auth_test;"
#   DATABASE_URL="postgresql://postgres:<pw>@127.0.0.1:5432/tanstack_auth_test" bun prisma db update

DATABASE_URL="postgresql://postgres:<password>@127.0.0.1:5432/tanstack_auth_test"
SESSION_SECRET=test-only-secret-not-used-for-real-sessions-32chars
APP_URL=http://localhost:3000
ARGON2_TEST_WEAK=1
