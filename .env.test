# 测试专用环境变量。
#
# 指向本机 PostgreSQL 的独立测试库，绝不指向生产（Neon）库 ——
# 测试会真实建表、建用户、删数据，连生产库等于破坏线上数据。
#
# 首次准备（或在 contract 变更后重建）：
#   psql -h 127.0.0.1 -U postgres -c "DROP DATABASE IF EXISTS tanstack_auth_test;"
#   psql -h 127.0.0.1 -U postgres -c "CREATE DATABASE tanstack_auth_test;"
#   DATABASE_URL="postgresql://postgres:123456@127.0.0.1:5432/tanstack_auth_test" bun prisma db update
DATABASE_URL="postgresql://postgres:123456@127.0.0.1:5432/tanstack_auth_test"

SESSION_SECRET=test-only-secret-not-used-for-real-sessions-32chars
APP_URL=http://localhost:3000
