# Copy this file to `.env` and replace the placeholders with your real values.

# Neon Postgres — 运行时用池化连接（host 带 -pooler）。
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — Prisma CLI（db push / migrate）用非池化直连（host 去掉 -pooler）。
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# better-auth 会话签名密钥（≥ 32 字符随机串）。
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# 站点对外地址（better-auth 使用，无尾斜杠）。
BETTER_AUTH_URL=http://localhost:3000

# SMTP 邮件发送。未设置 SMTP_HOST 时邮件只输出到服务端控制台。
SMTP_HOST=
SMTP_PORT=587
# 端口 465 时默认 true，其余默认 false；需要时显式覆盖。
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# 发件地址，如 "My App <noreply@example.com>"；留空则用 SMTP_USER。
EMAIL_FROM=
