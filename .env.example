# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Optional: separate database for integration tests (bun test).
# Leave unset to skip integration tests. Never point this at your dev database.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/tanstack_auth_test"

SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Externally reachable site origin, used in password-reset email links.
# e.g. https://yourdomain.com (no trailing slash).
APP_URL=http://localhost:3000
