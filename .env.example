# Copy this file to `.env` and replace the placeholders with your real values.
# Neon Postgres connection string (pooler endpoint).

DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Externally reachable site origin, used in password-reset email links.
# e.g. https://yourdomain.com (no trailing slash).
APP_URL=http://localhost:3000
